# RasoRead Environment Configuration
# Copy this file to .env and fill in your values

# App
APP_NAME=RasoRead
ENVIRONMENT=development  # or production

# Database (update with your credentials)
DATABASE_URL=postgresql+asyncpg://rasoread:rasoread@localhost:5432/rasoread

# Redis / Celery (if using)
REDIS_URL=redis://localhost:6379/0

# Auth - IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
# For S3 storage:
# STORAGE_BACKEND=s3
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# AI Provider - At least one required for AI features
# AI_PROVIDER=gemini  # default
# GEMINI_API_KEY=your-gemini-key
# GROQ_API_KEY=your-groq-key
# OPENAI_API_KEY=your-openai-key

# TTS Provider
# TTS_PROVIDER=gemini  # default (uses Gemini TTS or falls back to OpenAI)
# ELEVENLABS_API_KEY=your-elevenlabs-key  # premium option

# Email (SMTP) - Required for email verification and password reset
# For Gmail: Use App Password (not your regular password)
# Settings > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=RasoRead

# For other SMTP providers (SendGrid, AWS SES, etc.):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# For production, add your domain:
# ALLOWED_ORIGINS=["https://yourdomain.com"]

# File limits
MAX_UPLOAD_SIZE_MB=100
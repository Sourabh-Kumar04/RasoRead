# ════════════════════════════════════════════════════════════════════════════
# RasoRead — Environment Configuration
# Copy this file to .env and fill in your values.
#
# DEPLOYMENT GUIDE:
#   Frontend  → Vercel (set NEXT_PUBLIC_API_URL to your Railway API URL)
#   Backend   → Railway (deploy apps/api with the Dockerfile)
#   Database  → Supabase (copy the connection string below)
#   Storage   → Supabase Storage (S3-compatible, see AWS_ vars below)
#   Redis     → Railway Redis addon
# ════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Local:    postgresql+asyncpg://rasoread:rasoread@localhost:5432/rasoread
# Supabase: postgresql+asyncpg://postgres.[ref]:[password]@aws-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://rasoread:rasoread@localhost:5432/rasoread

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local:   redis://localhost:6379/0
# Railway: redis://default:[password]@[host]:6379
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET to a strong random value in production!
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# For Gmail: use App Password (generate at myaccount.google.com/security)
# For other providers: use regular SMTP credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@rasoread.com
SMTP_FROM_NAME=RasoRead

# ── Storage ───────────────────────────────────────────────────────────────────
# Options: local | s3
# For Supabase Storage (S3-compatible):
#   STORAGE_BACKEND=s3
#   AWS_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
#   AWS_S3_BUCKET=books   (create this bucket in Supabase Storage)
#   AWS_REGION=us-east-1
#   AWS_ACCESS_KEY_ID=<supabase service role key>
#   AWS_SECRET_ACCESS_KEY=<supabase service role key>
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
AWS_ENDPOINT_URL=
AWS_S3_BUCKET=books
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── FAISS Index Storage ───────────────────────────────────────────────────────
# On Railway: mount a persistent volume at /data and set this to /data/faiss
FAISS_INDEX_DIR=./faiss_indexes

# ════════════════════════════════════════════════════════════════════════════
# AI PROVIDER
# Options: gemini | groq | openai
# ════════════════════════════════════════════════════════════════════════════
AI_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ════════════════════════════════════════════════════════════════════════════
# TTS PROVIDER
# Edge TTS is free and requires no API key (default).
# Options: edge | gemini | openai | elevenlabs
# ════════════════════════════════════════════════════════════════════════════
TTS_PROVIDER=edge

# ElevenLabs — https://elevenlabs.io
ELEVENLABS_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your Vercel deployment URL here in production:
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
